# Copy to .env and fill in. .env is git-ignored — never commit keys.
# Local defaults (no keys) run the full suite on mock + SQLite.

# --- deploy (required under docker-compose, fail-fast, no defaults) ---
# POSTGRES_PASSWORD=set-me
# API_KEY=set-me

# --- local overrides ---
# DATABASE_URL=sqlite:///./data/omniguard.db
# REDIS_URL=
# MLFLOW_TRACKING_URI=./mlruns

# --- LLM provider: mock | nim | bedrock ---
LLM_PROVIDER=mock
STRICT_LLM=false

# --- NVIDIA NIM (https://integrate.api.nvidia.com/v1, free key) ---
# NIM_API_KEY=nvapi-...
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_REASON_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# RATE_LIMIT_PER_MIN=40
# NIM_IDLE_TIMEOUT_S=30
# NIM_DEADLINE_S=300
# NIM_MAX_ATTEMPTS=3

# --- AWS Bedrock (alternate provider) ---
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
